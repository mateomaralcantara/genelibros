# ============================================================
# GeneLibros — variables de entorno (plantilla SIN valores)
# Copia a .env.local para desarrollo. Nunca subas .env.local.
# Detalle de cada variable: README.md → "Variables de entorno".
# ============================================================

# ---------- Navegador (públicas: acaban en el JavaScript) ----------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GEMINI_MODEL=

# SOLO en .env.local para desarrollo. Nunca en Vercel.
VITE_GEMINI_API_KEY=

# ---------- Servidor (Vercel → Environment Variables) ----------
# Si faltan SUPABASE_URL / SUPABASE_ANON_KEY se usan las VITE_ de arriba.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Nunca con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Secreto de los workers (genera uno largo y aleatorio).
OS4_WORKER_SECRET=
RESEARCH_WORKER_SECRET=

# Opcional: proveedor de búsqueda para /api/research.
RESEARCH_SEARCH_ENDPOINT=
RESEARCH_API_KEY=

# Opcional: límites por usuario (por defecto en README). 0 = sin límite.
# RATE_LIMIT_COMPOSER_HOURLY=60
# RATE_LIMIT_COMPOSER_DAILY=300
